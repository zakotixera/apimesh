# Scratch / regenerable staging (extract drafts)
# Contents are regenerable and ignored; the directory's README is documentation and tracked.
.raw/*
!.raw/README.md

# Disposable CLI diagnostics (extract / validate / drift)
.reports/*
!.reports/README.md

# Local tool state (agent session continuity, etc.)
.omo/
.claude/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# NOTE: sources/ and dist/ are intentionally tracked.
