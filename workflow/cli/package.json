{
  "name": "apic",
  "version": "0.1.0",
  "private": true,
  "description": "Universal CLI for apimesh workflows (HAR → canonical → dist)",
  "bin": {
    "apic": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "apic": "node ./dist/cli.js",
    "link": "npm link",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests=false",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:har": "npm run build && node scripts/check-har.cjs",
    "test:ablation": "npm run build && node scripts/ablate.cjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "newman": "^6.2.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "overrides": {
    "postman-request": "2.88.1-postman.48",
    "postman-collection": {
      "@faker-js/faker": "6.3.1"
    },
    "serialised-error": {
      "uuid": "8.3.2"
    }
  }
}
