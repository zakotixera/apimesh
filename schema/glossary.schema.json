{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "domains"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "required": [
          "slug",
          "meaning"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "known-codes": {
            "type": "array",
            "default": [],
            "items": {
              "type": "integer"
            },
            "uniqueItems": true
          },
          "http-shapes": {
            "type": "array",
            "default": [],
            "items": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
