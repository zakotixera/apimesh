{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": [
    "http",
    "code",
    "captured",
    "account",
    "request",
    "response"
  ],
  "properties": {
    "http": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "captured": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "method",
        "url",
        "body"
      ],
      "properties": {
        "httpMeta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpVersion": {
              "$ref": "#/$defs/httpVersion"
            }
          }
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string",
          "description": "HTTP(S) URL with optional masking placeholders in query values.",
          "pattern": "^https?://[^/?#\\s]+(?:[/?#][^\\s]*)?$"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "bodyMeta": {
          "$ref": "#/$defs/bodyMetadata"
        },
        "query": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/nameValue"
          },
          "description": "Decoded URL query pairs in capture order, preserving duplicates and empty values."
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/capturedBody"
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "status",
        "body"
      ],
      "properties": {
        "httpMeta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpVersion": {
              "$ref": "#/$defs/httpVersion"
            },
            "entryTime": {
              "type": "number",
              "minimum": 0,
              "description": "Total HAR entry elapsed time in milliseconds (entry.time), not a timestamp. Omitted when unavailable."
            }
          }
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "bodyMeta": {
          "$ref": "#/$defs/bodyMetadata",
          "properties": {
            "representation": {
              "enum": [
                "text",
                "json",
                "base64"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/capturedBody"
        }
      ]
    }
  },
  "$defs": {
    "httpVersion": {
      "type": "string",
      "pattern": "\\S",
      "description": "HTTP version label as captured, such as HTTP/1.1, HTTP/2.0, h2 or h3. Omitted when unavailable."
    },
    "bodyMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "source"
      ],
      "properties": {
        "mimeType": {
          "type": "string"
        },
        "representation": {
          "enum": [
            "text",
            "json",
            "params",
            "base64"
          ]
        },
        "source": {
          "enum": [
            "text",
            "params",
            "missing"
          ]
        }
      }
    },
    "bodyParam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        }
      }
    },
    "capturedBody": {
      "allOf": [
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "source": {
                    "const": "missing"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "null"
              },
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "const": "text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "source": {
                    "const": "params"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "const": "params"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "enum": [
                      "text",
                      "base64"
                    ]
                  },
                  "source": {
                    "const": "text"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "enum": [
                      "json",
                      "base64"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "bodyMeta": {
                "properties": {
                  "source": {
                    "const": "text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "const": "base64"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "bodyMeta"
            ],
            "properties": {
              "bodyMeta": {
                "properties": {
                  "representation": {
                    "const": "params"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/bodyParam"
                }
              },
              "bodyMeta": {
                "properties": {
                  "source": {
                    "const": "params"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "headers": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "description": "Captured header values, including Cookie and Set-Cookie, after masking. Repeated fields use arrays in capture order."
    },
    "nameValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
